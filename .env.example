# Canvas institution. Scheme and host only — no path, user, or query.
# The server sends the client secret only to this origin.
CANVAS_BASE_URL=https://canvas.example.edu

# Developer key from that institution: Admin → Developer Keys → API Key.
# Leave these unprefixed. A VITE_ prefix would ship the secret to the browser.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Must match a redirect URI on the developer key, character for character.
CANVAS_REDIRECT_URI=http://localhost:5173/api/auth/canvas/callback

# Optional. Space-separated Canvas API scopes.
# Leave unset when the key does not enforce scopes.
# Set to /auth/userinfo to use Canvas only as identity (name and Canvas ID, no API token).
# The dashboard needs these scopes when the key enforces them:
# url:GET|/api/v1/courses
# url:GET|/api/v1/courses/:course_id/assignments
# url:GET|/api/v1/courses/:course_id/quizzes
# url:GET|/api/v1/calendar_events
# url:GET|/api/v1/planner_notes
# CANVAS_OAUTH_SCOPES=

# Encrypts the login session cookie. Use a long random string.
SESSION_SECRET=
